{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/login", "destination": "/client/login.html" },
    { "source": "/admin", "destination": "/client/admin.html" },
    { "source": "/admin/(.*)", "destination": "/client/admin.html" },
    { "source": "/(.*)", "destination": "/client/$1" }
  ]
}
